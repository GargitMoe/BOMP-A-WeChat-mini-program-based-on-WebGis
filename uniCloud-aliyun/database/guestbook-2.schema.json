// 文档教程: https://uniapp.dcloud.net.cn/uniCloud/schema
// 文档教程: https://uniapp.dcloud.net.cn/uniCloud/schema
{
	"bsonType": "object",
	"required": [],
	"permission": {
		"read": true,
		"create":  "auth.uid!=null",
		"update":  true,
		"delete":  true
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"text":{
			"bsonType": "string"

			
		},
		"state":{
			"bsonType": "bool",
			"forceDefaultValue":true
		},
		"user_id":{
			"foreignKey": "uni-id-users._id",
			"bsonType": "string",
			"forceDefaultValue":
			{
				"$env": "uid"  //检查是不是用户自己的uid
			}
		}
	}
}